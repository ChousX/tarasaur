#!/usr/bin/env bash
# bench-lock - one benchmark at a time ON TOTH, and only while toth is quiet.
#
# The Deck has `deck-queue` because two runs measure each other. toth has the
# same problem twice over: several agents build and bench here at once, so a
# timing taken at load 12 on 16 cores is measuring the other agents, not the
# change under test. This is the same ticket queue pointed at toth, with a
# readiness check on load average instead of on an ssh login.
#
#   bench-lock run <name> -- <cmd...>   wait for the queue AND for a quiet toth
#   bench-lock status | log | cancel | preflight
#
# BENCH_LOCK_MAXLOAD (default 4.0) is the 1-minute load average the machine
# must be under before a run is allowed to start. Note it does not *keep* the
# machine quiet: it waits for a gap. Agents still have to not start a build
# while someone is measuring, which is what the queue is for.
set -euo pipefail
MAXLOAD="${BENCH_LOCK_MAXLOAD:-4.0}"
export DECK_QUEUE_STATE="${BENCH_LOCK_STATE:-$HOME/.local/state/toth-bench}"
export DECK_QUEUE_RESOURCE="toth (quiet, load < $MAXLOAD)"
export DECK_QUEUE_DECK_POLL="${BENCH_LOCK_POLL:-60}"
export DECK_QUEUE_READY_CMD="
  l=\$(cut -d' ' -f1 /proc/loadavg)
  if awk -v l=\"\$l\" -v m=$MAXLOAD 'BEGIN{exit !(l<m)}'; then exit 0; fi
  echo \"toth load is \$l, waiting for it to fall below $MAXLOAD\"
  exit 1
"

exec /home/chousx/.local/bin/deck-queue "$@"
